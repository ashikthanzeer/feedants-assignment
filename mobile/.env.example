# Base URL of the competition API, WITHOUT a trailing slash.
# Defaults to http://localhost:5000/api when unset.
#  - Web / iOS simulator : http://localhost:5000/api
#  - Android emulator    : http://10.0.2.2:5000/api
#  - Physical device     : http://<your-machine-lan-ip>:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# User id used when loading/registering for a competition.
EXPO_PUBLIC_USER_ID=demo-user